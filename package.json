{
  "name": "hono-explorer",
  "version": "0.1.1",
  "description": "Zero-dependency devtool for Hono: routes map, live request tracing, and named spans, served from your own app.",
  "keywords": [
    "hono",
    "devtools",
    "tracing",
    "spans",
    "routes",
    "middleware",
    "debug",
    "profiler",
    "waterfall"
  ],
  "license": "MIT",
  "author": "",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/devgauravjatt/hono-explorer.git"
  },
  "bugs": {
    "url": "https://github.com/devgauravjatt/hono-explorer/issues"
  },
  "homepage": "https://github.com/devgauravjatt/hono-explorer#readme",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "rslib",
    "check": "biome check --write",
    "dev": "nub watch tests/index.ts",
    "format": "biome format --write",
    "lint": "biome lint --write",
    "test": "rstest",
    "test:watch": "rstest --watch",
    "prepare": "husky"
  },
  "peerDependencies": {
    "hono": ">=4.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.10",
    "@hono/node-server": "^2.1.1",
    "@nubjs/nub": "^0.7.5",
    "@rslib/core": "^0.23.2",
    "@rstest/adapter-rslib": "^0.11.9",
    "@rstest/core": "^0.11.9",
    "@types/node": "^24.13.2",
    "hono": "^4.13.3",
    "husky": "^9.1.7",
    "nano-staged": "^1.0.2",
    "typescript": "^6.0.3"
  },
  "nano-staged": {
    "*.{js,ts}": [
      "biome format --write .",
      "biome lint --write ."
    ]
  },
  "engines": {
    "node": ">=18"
  }
}
